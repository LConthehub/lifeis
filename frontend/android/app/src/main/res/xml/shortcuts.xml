<?xml version="1.0" encoding="utf-8"?>
<!-- What long-pressing the Life Is icon offers, and what Google's assistant can open by name. Each opens one of
     Life Is's short requests (core/src/actions.ts) at a link the app handles; anything that adds waits for a tap.
     Android shows at most four static shortcuts. targetPackage and targetClass keep the link inside this app. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_to_groceries"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_groceries_short"
        android:shortcutLongLabel="@string/shortcut_groceries_long">
        <intent android:action="android.intent.action.VIEW" android:data="living.lifeis.home://do/add-to-groceries"
            android:targetPackage="living.lifeis.home" android:targetClass="living.lifeis.home.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="record_spending"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_spent_short"
        android:shortcutLongLabel="@string/shortcut_spent_long">
        <intent android:action="android.intent.action.VIEW" android:data="living.lifeis.home://do/record-spending"
            android:targetPackage="living.lifeis.home" android:targetClass="living.lifeis.home.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="whats_for_dinner"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_dinner_short"
        android:shortcutLongLabel="@string/shortcut_dinner_long">
        <intent android:action="android.intent.action.VIEW" android:data="living.lifeis.home://do/whats-for-dinner"
            android:targetPackage="living.lifeis.home" android:targetClass="living.lifeis.home.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="where_is"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_where_short"
        android:shortcutLongLabel="@string/shortcut_where_long">
        <intent android:action="android.intent.action.VIEW" android:data="living.lifeis.home://do/where-is"
            android:targetPackage="living.lifeis.home" android:targetClass="living.lifeis.home.MainActivity" />
    </shortcut>
</shortcuts>
