<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Life Is makes no copies of itself anywhere it wasn't asked to: nothing goes to the phone maker's
         cloud backup or across to a new phone on its own (allowBackup, dataExtractionRules). The database's
         key lives in this phone's keystore and would not survive the trip anyway.
         usesCleartextTraffic lets the app reach a Life Is on the home network at an http:// address, which
         is how most people run one at home. The app says so plainly before connecting to one. -->

    <!-- The camera reads barcodes and QR codes in the app (Scanner, Scan many). Not required: a phone with no camera still works by typing the number. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_copies"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links that open one of Life Is's short requests: living.lifeis.home://do/add-to-groceries?item=eggs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="do" />
            </intent-filter>

            <!-- What long-pressing the icon offers (res/xml/shortcuts.xml). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The morning reminders the app makes on the phone (Android 13 and later asks the person first). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
